# Secure local-only baseline for the Tibo-style claudex launcher.
# Configuration layout: CLIProxyAPI 7.2.130 (Homebrew baseline).
# Check your installed version; newer versions may reorganize these keys.
host: "127.0.0.1"
port: 8317

tls:
  enable: false
  cert: ""
  key: ""

remote-management:
  allow-remote: false
  secret-key: ""
  disable-control-panel: true

auth-dir: "~/.cli-proxy-api"

api-keys:
  - "REPLACE_WITH_LOCAL_KEY"

debug: false
commercial-mode: false
logging-to-file: false
logs-max-total-size-mb: 0
# Failed requests can still create logs containing prompt/request bodies.
error-logs-max-files: 10
usage-statistics-enabled: false

proxy-url: ""
request-retry: 3
max-retry-credentials: 1
max-retry-interval: 30

routing:
  strategy: "fill-first"
  session-affinity: true
  session-affinity-ttl: "1h"

codex:
  identity-confuse: false
